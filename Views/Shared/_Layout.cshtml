<!DOCTYPE html>

<html lang="en">

<head>

    <!-- Define the character encoding used by the page. -->
    <meta charset="utf-8" />

    <!-- Make the website responsive on mobile devices. -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Display the current Razor page title in the browser tab. -->
    <title>@ViewData["Title"] - Hospital Appointment Management System</title>

    <!-- Load Bootstrap for responsive layout and UI components. -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Load the application's custom CSS file. -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <!-- Main navigation bar. -->
    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">

            <div class="container">

                <!-- Application name and home link. -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Doctor"
                   asp-action="Index">

                    🏥 Hospital Appointment

                </a>

                <!-- Mobile navigation button. -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation links. -->
                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto">

                        <!-- Doctors page. -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Doctor"
                               asp-action="Index">

                                Doctors

                            </a>

                        </li>


                        <!-- Appointments page. -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Doctor"
                               asp-action="Appointments">

                                Appointments

                            </a>

                        </li>


                        <!-- API Posts page. -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Doctor"
                               asp-action="Posts">

                                API Posts

                            </a>

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- Main page content. -->
    <main role="main">

        @RenderBody()

    </main>


    <!-- Footer section. -->
    <footer class="border-top footer text-muted mt-5">

        <div class="container py-3 text-center">

            © @DateTime.Now.Year -
            Hospital Appointment Management System

        </div>

    </footer>


    <!-- Load Bootstrap JavaScript for responsive navigation. -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Allow individual Razor pages to add their own scripts. -->
    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>
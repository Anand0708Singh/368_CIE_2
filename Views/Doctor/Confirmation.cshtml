@model _368_CIE_2.Models.Appointment

@{
    ViewData["Title"] = "Appointment Confirmation";
}

<div class="container py-5">

    <!-- Confirmation heading. -->
    <div class="text-center mb-4">
        <h1>Appointment Submitted Successfully</h1>

        <p class="text-muted">
            Your appointment request has been recorded.
        </p>
    </div>

    <!-- Appointment information. -->
    <div class="card shadow-sm mx-auto" style="max-width: 650px;">

        <div class="card-body">

            <h3 class="mb-4">
                Appointment Details
            </h3>

            <!-- Patient name comes from the Cookie-backed appointment data. -->
            <p>
                <strong>Patient Name:</strong>
                @Model.PatientName
            </p>

            <!-- Doctor name. -->
            <p>
                <strong>Doctor:</strong>
                @Model.DoctorName
            </p>

            <!-- Doctor ID came from the hidden form field. -->
            <p>
                <strong>Doctor ID:</strong>
                @Model.DoctorId
            </p>

            <!-- Specialization came from Session-backed appointment processing. -->
            <p>
                <strong>Specialization:</strong>
                @Model.Specialization
            </p>

            <!-- Appointment date. -->
            <p>
                <strong>Appointment Date:</strong>
                @Model.AppointmentDate.ToString("dd MMM yyyy, hh:mm tt")
            </p>

            <!-- Navigation buttons. -->
            <div class="mt-4">

                <a asp-controller="Doctor"
                   asp-action="Appointments"
                   class="btn btn-primary">
                    View Appointments
                </a>

                <a asp-controller="Doctor"
                   asp-action="Index"
                   class="btn btn-secondary ms-2">
                    Back to Doctors
                </a>

            </div>

        </div>

    </div>

</div>
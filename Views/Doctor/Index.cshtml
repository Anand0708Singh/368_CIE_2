@model List<_368_CIE_2.Models.Doctor>

@{
    // Set the title displayed in the browser tab.
    ViewData["Title"] = "Doctors";
}

<!-- Main container for the doctor list. -->
<div class="container py-5">

    <!-- Page heading. -->
    <div class="text-center mb-5">

        <!-- Main page title. -->
        <h1 class="display-5 fw-bold">
            Our Doctors
        </h1>

        <!-- Short description below the heading. -->
        <p class="text-muted">
            Choose a specialist and book your hospital appointment.
        </p>

    </div>

    <!-- Responsive row containing all doctor cards. -->
    <div class="row g-4">

        @foreach (var doctor in Model)
        {
            <!-- Responsive column for one doctor. -->
            <div class="col-md-6 col-lg-3">

                <!-- Doctor card. -->
                <div class="card h-100 shadow-sm border-0">

                    <!-- Doctor card content. -->
                    <div class="card-body d-flex flex-column">

                        <!-- Doctor name. -->
                        <h4 class="card-title fw-bold">
                            @doctor.DoctorName
                        </h4>

                        <!-- Doctor specialization. -->
                        <p class="text-primary fw-semibold">
                            @doctor.Specialization
                        </p>

                        <!-- Doctor ID. -->
                        <p class="mb-2">
                            <strong>Doctor ID:</strong>
                            @doctor.DoctorId
                        </p>

                        <!-- Doctor experience. -->
                        <p class="mb-2">
                            <strong>Experience:</strong>
                            @doctor.Experience years
                        </p>

                        <!-- Doctor consultation fee. -->
                        <p class="mb-2">
                            <strong>Consultation Fee:</strong>
                            ₹@doctor.ConsultationFee
                        </p>

                        <!-- Fixed service charge required by the practical. -->
                        <p class="mb-2">
                            <strong>Service Charge:</strong>
                            ₹100
                        </p>

                        <!-- Calculate the total using the extension method. -->
                        <p class="mb-4">
                            <strong>Total Charge:</strong>

                            <span class="text-success fw-bold">
                                ₹@doctor.CalculateTotalCharge()
                            </span>
                        </p>

                        <!-- Keep the action buttons at the bottom of every card. -->
                        <div class="mt-auto">

                            <!-- Pass DoctorId through the query string to the Details action. -->
                            <a class="btn btn-outline-primary w-100 mb-2"
                               asp-controller="Doctor"
                               asp-action="Details"
                               asp-route-doctorId="@doctor.DoctorId">

                                View Details

                            </a>

                            <!-- Pass DoctorId to the appointment form. -->
                            <a class="btn btn-primary w-100"
                               asp-controller="Doctor"
                               asp-action="Appointment"
                               asp-route-doctorId="@doctor.DoctorId">

                                Book Appointment

                            </a>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

    <!-- Explain the practical concepts demonstrated by this page. -->
    <div class="alert alert-info mt-5">

        <strong>Practical Concepts:</strong>

        Doctor Model,
        Extension Method,
        ₹100 Service Charge,
        IMemoryCache,
        Query String.

    </div>

</div>